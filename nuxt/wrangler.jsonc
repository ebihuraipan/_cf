{
  "name": "cf-hello-world",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-05-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "cf-rag-index-ja",
      "remote": true
    }
  ]
}
